---
const { id = 'sub', heading = 'Get the VetTV Handheld weekly', compact = false } = Astro.props;
---
<section class={`subscribe ${compact ? 'compact' : ''}`} data-pagefind-ignore aria-labelledby={`${id}-h`}>
  <div class="sub-copy">
    <h2 id={`${id}-h`}>{heading}</h2>
    <p>A weekly email with the latest handheld news and guides. Steam Deck, Legion Go, SteamOS, Decky and more. No spam, unsubscribe anytime.</p>
  </div>
  <form class="sub-form embeddable-buttondown-form" action="https://buttondown.com/api/emails/embed-subscribe/VetTVStudios" method="post" target="popupwindow" onsubmit="window.open('https://buttondown.com/VetTVStudios', 'popupwindow')">
    <label for={`${id}-email`} class="sr">Email address</label>
    <input id={`${id}-email`} type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
    <input type="hidden" name="embed" value="1" />
    <button type="submit">Subscribe</button>
  </form>
  <p class="sub-fine">Powered by <a href="https://buttondown.com/VetTVStudios" target="_blank" rel="noopener">Buttondown</a>.</p>
</section>
