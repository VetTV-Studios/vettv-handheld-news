---
import Base from '../layouts/Base.astro'; import { SITE, url, asset } from '../site';
---
<Base title="About" description="About VetTV Handheld News, from VetTV Studios." >
  <article class="post page-doc">
    <p class="kicker">About</p><h1>About VetTV Handheld News</h1>
    <div class="prose">
      <p>VetTV Handheld News is VetTV Studios' news site for handheld PCs and gaming: Steam Deck, ROG Ally, Legion Go and Steam Frame, plus Windows, Linux &amp; SteamOS, macOS and the open NT projects that keep old software running.</p>
      <p>Every story links its sources. Opinion pieces are labelled. Stories are written by Vet with help from VetTV's editorial tools, and every one is reviewed by Vet before it goes live.</p>
      <p>Follow along on <a href={SITE.youtube}>YouTube</a> or the <a href={asset('rss.xml')}>RSS feed</a>, or see <a href={url('official-links')}>our official links</a>.</p>
    </div>
  </article>
</Base>
