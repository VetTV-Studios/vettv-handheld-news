---
// Content-type page (was a section before the Oct 2026 redesign; URL kept).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro'; import Card from '../components/Card.astro';
import { sortPosts } from '../site';
const posts = sortPosts((await getCollection('posts')).filter(p => p.data.type === 'guide'));
---
<Base title="Guides" description="Guides from VetTV Handheld News, across every section.">
  <header class="page-head"><p class="kicker">Type</p><h1 class="page-h">Guides</h1><p class="cat-desc">Guides from every section.</p></header>
  {posts.length ? <section class="grid">{posts.map((p, i) => <Card post={p} big={i === 0} />)}</section> : <p class="muted">No guides yet. Coming soon.</p>}
</Base>
