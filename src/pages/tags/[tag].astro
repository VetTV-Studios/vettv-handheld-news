---
import { getCollection } from 'astro:content'; import Base from '../../layouts/Base.astro'; import Card from '../../components/Card.astro'; import { sortPosts } from '../../site';
export async function getStaticPaths() { const all = await getCollection('posts'); const tags = [...new Set(all.flatMap(p => p.data.tags))];
  return tags.map(tag => ({ params: { tag }, props: { posts: sortPosts(all.filter(p => p.data.tags.includes(tag))) } })); }
const { tag } = Astro.params; const { posts } = Astro.props;
---
<Base title={`#${tag}`} active="tags"><h1 class="page-h">#{tag}</h1><section class="grid">{posts.map(p => <Card post={p} />)}</section></Base>
