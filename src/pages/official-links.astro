---
import Base from '../layouts/Base.astro'; import { SITE, SOCIALS, url, asset } from '../site';
---
<Base title="Official links" description="The only official VetTV Handheld News accounts." >
  <article class="post page-doc">
    <p class="kicker">Channels</p><h1>Official links</h1>
    <div class="prose">
      <p>These are the only official VetTV Handheld News channels. Anything else claiming to be us isn't.</p>
      <ul>
        {SOCIALS.map(x => <li><b>{x.name}:</b> <a href={x.href} rel="me noopener">{x.handle}</a></li>)}
        <li><b>RSS:</b> <a href={asset('rss.xml')}>{new URL(asset('rss.xml'), Astro.site).href}</a></li>
        <li><b>Newsletter:</b> <a href={url('subscribe')}>VetTV Handheld weekly</a> (via Buttondown)</li>
      </ul>
    </div>
  </article>
</Base>
